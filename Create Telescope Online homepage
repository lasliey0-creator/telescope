    if (selected === "ar" || selected === "fa") {

      document.documentElement.dir = "rtl";

    } else {

      document.documentElement.dir = "ltr";

    }

    localStorage.setItem("telescope-language", selected);

  });


  const savedLanguage =
    localStorage.getItem("telescope-language");

  if (savedLanguage) {

    language.value = savedLanguage;

